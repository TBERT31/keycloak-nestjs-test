meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{base_url_keycloak}}/admin/realms/{{realm}}/users
  body: json
  auth: none
}

body:json {
  {
    "username": "berteau.thomas@hotmail.fr",
    "firstName": "Thomas",
    "lastName": "Berteau",
    "email": "berteau.thomas@hotmail.fr",
    "emailVerified": false,
    "enabled": true,
    "credentials": [
      {
        "type": "password",
        "value": "Admin@1234",
        "temporary": false
      }
